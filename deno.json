{
  "nodeModulesDir": "auto",
  "workspace": [
    "./cli/tutors",
    "./packages/model",
    "./packages/gen",
    "./packages/time"
  ],
  "fmt": {
    "include": ["./packages/gen/src/", "./packages/model/src/", "./cli/tutors/"],
    "useTabs": false,
    "lineWidth": 180,
    "indentWidth": 2,
    "singleQuote": false
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "publish": "deno publish",
    "publish-test": "deno publish --dry-run"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
