{
  "name": "@tutors/ui",
  "version": "0.0.1",
  "description": "Shared Svelte UI components for Tutors",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/lib/components/*"
  },
  "scripts": {
    "build": "svelte-package -o dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tutors/tutors-model-lib": "*",
    "@tutors/services": "*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@iconify/svelte": "^5.2.1",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
