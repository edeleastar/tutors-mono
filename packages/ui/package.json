{
  "name": "@tutors/ui",
  "version": "0.0.1",
  "description": "Shared Svelte UI components for Tutors",
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/lib/components/*",
    "./navigators/*": "./src/lib/navigators/*",
    "./styles.css": "./dist/style.css"
  },
  "scripts": {
    "build": "svelte-package -o dist && vite build --config vite.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tutors/services": "*",
    "@tutors/tutors-model-lib": "*"
  },
  "devDependencies": {
    "@iconify/svelte": "^5.2.1",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.0.0"
  }
}
